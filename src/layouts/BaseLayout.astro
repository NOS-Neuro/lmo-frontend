---
interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title,
  description = "VizAI helps businesses control how AI systems describe them.",
  canonicalPath,
  ogTitle,
  ogDescription,
  ogType = "website",
  twitterTitle,
  twitterDescription,
} = Astro.props;

const siteUrl = "https://vizai.app";
const canonical = canonicalPath ? `${siteUrl}${canonicalPath}` : undefined;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  {ogTitle && <meta property="og:title" content={ogTitle} />}
  {ogDescription && <meta property="og:description" content={ogDescription} />}
  <meta property="og:type" content={ogType} />
  {canonical && <meta property="og:url" content={canonical} />}

  <meta name="twitter:card" content="summary_large_image" />
  {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
  {twitterDescription && <meta name="twitter:description" content={twitterDescription} />}

  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Tailwind utilities (no base reset — our global.css handles that) -->
  <style is:global>@import "../styles/tailwind.css";</style>

  <!-- Global Styles -->
  <link rel="stylesheet" href="/styles/critical.css" />
  <link rel="stylesheet" href="/styles/global.css" media="print" onload="this.media='all'; this.onload=null;" />
  <noscript><link rel="stylesheet" href="/styles/global.css" /></noscript>

  <!-- Error Tracking -->
  <script is:inline src="/error-tracking.js"></script>

  <!-- Vercel Web Analytics -->
  <script is:inline>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>

  <!-- Page-specific head content -->
  <slot name="head" />
</head>
<body>
  <noscript>
    <div class="noscript-warning">
      ⚠️ VizAI requires JavaScript to function properly.
      Please <a href="https://www.enable-javascript.com/" target="_blank" rel="noopener">enable JavaScript</a> in your browser settings.
    </div>
  </noscript>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/" class="brand">
        <img src="/assets/vizai-icon.svg" alt="VizAI" class="logo-mark" />
        <div class="logo-text">VizAI</div>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/packages">Pricing</a>
        <a href="/about">About</a>
        <a href="/faq">FAQ</a>
        <a href="/onboarding-form">Onboarding</a>
        <a href="/contact">Contact</a>
        <a href="/scan" class="cta">
          <span>Free Scan</span>
          <span class="icon">→</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-column">
        <h3>VizAI</h3>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/scan">Run Free Scan</a>
          <a href="/packages">Pricing</a>
          <a href="/about">About</a>
        </div>
      </div>
      <div class="footer-column">
        <h3>Resources</h3>
        <div class="footer-links">
          <a href="/what-is-lmo">What is LMO?</a>
          <a href="/faq">FAQ</a>
          <a href="/agencies">For Agencies</a>
          <a href="/onboarding-form">Onboarding</a>
          <a href="https://vizai-io.github.io/business-registry/" target="_blank" rel="noopener noreferrer">VizAI Business Registry</a>
        </div>
      </div>
      <div class="footer-column">
        <h3>Company</h3>
        <div class="footer-links">
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <p class="footer-email">
            Email: <a href="mailto:hello@vizai.io">hello@vizai.io</a>
          </p>
        </div>
      </div>
    </div>
    <div class="copyright">
      &copy; {currentYear} VizAI. AI visibility diagnostics for modern businesses.
    </div>
  </footer>

  <script is:inline src="/scripts/main.js"></script>
</body>
</html>
