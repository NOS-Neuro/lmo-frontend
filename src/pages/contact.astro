---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | VizAI"
  description="Get in touch with VizAI. Questions about AI visibility? Let's talk."
  canonicalPath="/contact"
  ogTitle="Contact VizAI"
  ogDescription="Have questions about AI visibility? We're here to help."
  twitterTitle="Contact VizAI"
  twitterDescription="Get in touch about AI visibility management"
>
  <Fragment slot="head">
    <style>
      .contact-page {
        max-width: var(--max-width, 960px);
        margin: 0 auto;
        padding: 96px 16px 72px;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-top: 48px;
      }

      @media (max-width: 768px) {
        .contact-grid {
          grid-template-columns: 1fr;
        }
      }

      .contact-info {
        background: var(--bg-elevated, #050611);
        border-radius: 20px;
        border: 1px solid var(--border-subtle, #262738);
        padding: 32px;
      }

      .contact-info h3 {
        font-size: 1.3rem;
        margin-bottom: 16px;
      }

      .contact-info p {
        color: var(--muted, #c0c2d8);
        line-height: 1.7;
        margin-bottom: 16px;
      }

      .contact-info a {
        color: var(--accent-strong, #b89cff);
        text-decoration: none;
        transition: color 0.2s;
      }

      .contact-info a:hover {
        color: var(--accent, #7b5cff);
        text-decoration: underline;
      }

      .contact-form {
        background: var(--bg-elevated, #050611);
        border-radius: 20px;
        border: 1px solid var(--border-subtle, #262738);
        padding: 32px;
      }

      .form-field {
        margin-bottom: 20px;
      }

      .form-field label {
        display: block;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--muted, #c4c5d4);
      }

      .form-field input,
      .form-field select,
      .form-field textarea {
        width: 100%;
        padding: 0.75rem 0.9rem;
        border-radius: 10px;
        border: 1px solid var(--border-subtle, #303244);
        background: var(--bg-soft, #070818);
        color: var(--text, #f9fafb);
        font-size: 0.96rem;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
      }

      .form-field input::placeholder,
      .form-field textarea::placeholder {
        color: var(--muted, #7c7f96);
      }

      .form-field input:focus,
      .form-field select:focus,
      .form-field textarea:focus {
        border-color: var(--accent-strong, #8b5cff);
        box-shadow: 0 0 0 1px rgba(139, 92, 255, 0.5);
      }

      .form-field textarea {
        resize: vertical;
        min-height: 120px;
      }

      .submit-btn {
        width: 100%;
        margin-top: 8px;
      }

      .form-status {
        margin-top: 16px;
        padding: 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        display: none;
      }

      .form-status.success {
        display: block;
        background: rgba(76, 175, 80, 0.1);
        border: 1px solid rgba(76, 175, 80, 0.3);
        color: #4caf50;
      }

      .form-status.error {
        display: block;
        background: rgba(255, 107, 107, 0.1);
        border: 1px solid rgba(255, 107, 107, 0.3);
        color: #ff6b6b;
      }

      .contact-methods {
        display: grid;
        gap: 24px;
        margin-top: 32px;
      }

      .contact-method {
        padding: 20px;
        background: rgba(123, 92, 255, 0.05);
        border: 1px solid rgba(123, 92, 255, 0.15);
        border-radius: 12px;
      }

      .contact-method h4 {
        font-size: 1.1rem;
        margin-bottom: 8px;
      }

      .contact-method p {
        margin: 0;
        color: var(--muted, #c0c2d8);
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .contact-method a {
        color: var(--accent-strong, #b89cff);
        text-decoration: none;
        font-weight: 500;
      }

      .contact-method a:hover {
        text-decoration: underline;
      }
    </style>
  </Fragment>

  <main id="main-content">
    <section class="contact-page">
      <div class="center">
        <div class="pill">Contact Us</div>
        <h1 class="section-title" style="margin-top: 12px;">Get in Touch</h1>
        <p class="section-subtitle" style="max-width: 600px; margin: 16px auto 0;">
          Have questions about AI visibility? Want to discuss your specific needs? We're here to help.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Contact Information -->
        <div class="contact-info">
          <h3>How to Reach Us</h3>

          <div class="contact-methods">
            <div class="contact-method">
              <h4>For General Inquiries</h4>
              <p>
                Email: <a href="mailto:hello@vizai.io">hello@vizai.io</a><br>
                We typically respond within 1 business day.
              </p>
            </div>

            <div class="contact-method">
              <h4>For Tier 3 Enterprise Governance</h4>
              <p>
                Schedule a consultation to discuss custom AI governance needs:
              </p>
              <p style="margin-top: 12px;">
                <a href="https://calendly.com/vizai-governance"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn-secondary"
                   style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; padding: 10px 16px; border-radius: 8px; background: rgba(123, 92, 255, 0.1); border: 1px solid rgba(123, 92, 255, 0.3);">
                  <span>Schedule Consultation</span>
                  <span>📅</span>
                </a>
              </p>
            </div>

            <div class="contact-method">
              <h4>For Current Clients</h4>
              <p>
                Email: <a href="mailto:support@vizai.io">support@vizai.io</a><br>
                Support hours: Monday-Friday, 9am-5pm EST
              </p>
            </div>

            <div class="contact-method">
              <h4>Scan Results</h4>
              <p>
                Automated scan results are delivered instantly to your email.<br>
                Questions about your results: <a href="mailto:scans@vizai.io">scans@vizai.io</a>
              </p>
            </div>
          </div>

          <p style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border-subtle, #262738); font-size: 0.85rem;">
            <strong>Location:</strong> Canada<br>
            <strong>Business Hours:</strong> Monday-Friday, 9am-5pm EST
          </p>
        </div>

        <!-- Contact Form -->
        <div class="contact-form">
          <h3 style="margin-bottom: 24px;">Send Us a Message</h3>

          <form id="contactForm" action="https://formspree.io/f/mvzgdedo" method="POST">
            <input type="hidden" name="_subject" value="New VizAI Contact Form Submission">

            <div class="form-field">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" required placeholder="Your name">
            </div>

            <div class="form-field">
              <label for="email">Email *</label>
              <input type="email" id="email" name="_replyto" required placeholder="your@email.com">
            </div>

            <div class="form-field">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" placeholder="Your company (optional)">
            </div>

            <div class="form-field">
              <label for="interest">I'm interested in: *</label>
              <select id="interest" name="interest" required>
                <option value="">Select...</option>
                <option value="tier0">Tier 0 - AI Understanding Snapshot ($495 CAD)</option>
                <option value="tier1">Tier 1 - Canonical AI Foundation</option>
                <option value="tier2">Tier 2 - AI Signal Reinforcement</option>
                <option value="tier3">Tier 3 - Managed Governance</option>
                <option value="question">General Question</option>
                <option value="support">Technical Support</option>
              </select>
            </div>

            <div class="form-field">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="5" required placeholder="Tell us about your needs or questions..."></textarea>
            </div>

            <!-- Formspree honey pot (spam protection) -->
            <input type="text" name="_gotcha" style="display:none">

            <button type="submit" class="btn-primary submit-btn">
              <span>Send Message</span>
              <span class="icon">→</span>
            </button>

            <div id="formStatus" class="form-status"></div>
          </form>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="center" style="margin-top: 64px; padding: 40px 24px; background: rgba(123, 92, 255, 0.05); border-radius: 20px; border: 1px solid rgba(123, 92, 255, 0.15);">
        <h2 style="margin-bottom: 16px;">Not sure where to start?</h2>
        <p style="color: var(--muted, #c0c2d8); margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto;">
          Run a free visibility scan to see if AI is describing your business correctly. Takes less than 60 seconds.
        </p>
        <a href="/scan" class="btn-primary">
          <span>Run Free Scan</span>
          <span class="icon">⚡</span>
        </a>
      </div>
    </section>
  </main>

  <script is:inline>
    // Enhanced form handling with Formspree
    const form = document.getElementById('contactForm');
    const statusEl = document.getElementById('formStatus');

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      // Show loading state
      statusEl.textContent = 'Sending message...';
      statusEl.className = 'form-status';
      statusEl.style.display = 'block';

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          statusEl.textContent = 'Thanks for reaching out! We\'ll get back to you within 1 business day at ' + form.querySelector('[name="_replyto"]').value;
          statusEl.className = 'form-status success';
          form.reset();
        } else {
          const data = await response.json();
          if (data.errors) {
            statusEl.textContent = 'Oops! There was a problem: ' + data.errors.map(error => error.message).join(', ');
          } else {
            statusEl.textContent = 'Oops! There was a problem. Please email us directly at hello@vizai.io';
          }
          statusEl.className = 'form-status error';
        }
      } catch (error) {
        statusEl.textContent = 'Oops! There was a problem. Please email us directly at hello@vizai.io';
        statusEl.className = 'form-status error';
      }
    });
  </script>
</BaseLayout>
