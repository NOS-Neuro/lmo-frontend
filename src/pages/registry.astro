  <main>
    <section class="page-hero">
      <div class="shell page-hero-grid"><div><div class="eyebrow">VizAI Business Registry</div><h1>A public discovery layer for verified business facts.</h1></div><div><p class="page-hero-copy">The Registry publishes lightweight, structured records that link to richer business profiles and approved sources.</p><span class="sample-badge">Illustrative registry preview</span></div></div>
    </section>

    <section class="section compact">
      <div class="shell">
        <div class="registry-search"><input type="search" aria-label="Search the registry" placeholder="Search by business, domain, or location"><button class="button" type="button">Search registry</button></div>
