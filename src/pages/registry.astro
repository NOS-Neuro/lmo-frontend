          <article class="registry-item"><span class="record-mark">N</span><div class="registry-meta"><strong>Northstar Logistics Inc.</strong><small>Transportation and logistics · northstarlogistics.example</small></div><div class="registry-stat"><strong>Toronto, ON</strong><small>Primary location</small></div><div class="registry-stat"><strong>18 Jul 2026</strong><small>Last reviewed</small></div><span class="status-badge">Verified record</span></article>
