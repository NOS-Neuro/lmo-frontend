---
import RedesignLayout from '../layouts/RedesignLayout.astro';
import { getPreviewHostRedirect } from '../lib/preview-host-redirect.js';

const previewHostRedirect = getPreviewHostRedirect(process.env);
---

<RedesignLayout
  title="Free AI Representation Check | VizAI"
  description="Run a free VizAI representation check for explainable assessment bands, selected evidence, material findings, and a practical next step."
  canonicalPath="/scan"
  ogTitle="Free AI Representation Check | VizAI"
  ogDescription="Get an explainable, directional view of how AI can currently interpret your business."
  twitterTitle="Free AI Representation Check | VizAI"
  twitterDescription="Get an explainable, directional view of how AI can currently interpret your business."
>
  <Fragment slot="head">
    <link rel="dns-prefetch" href="https://lmo-backend.onrender.com">
    {previewHostRedirect && (
      <script
        is:inline
        define:vars={{
          deploymentHost: previewHostRedirect.deploymentHost,
          branchHost: previewHostRedirect.branchHost
        }}
      >
        if (window.location.hostname === deploymentHost) {
          window.location.replace(
            "https://" + branchHost + window.location.pathname + window.location.search + window.location.hash
          );
        }
      </script>
    )}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
      /* Page layout */
      .scan-page {
        max-width: var(--max-width, 960px);
        margin: 0 auto;
        padding: 96px 16px 72px;
      }

      .scan-header {
        text-align: center;
        margin-bottom: 32px;
      }

      .scan-header h1 {
        font-size: clamp(1.9rem, 4vw, 2.4rem);
        margin-bottom: 8px;
      }

      .scan-header p {
        color: var(--text-muted);
        font-size: 0.98rem;
      }

      .scan-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 32px;
        max-width: 580px;
        margin: 0 auto;
      }

      @media (max-width: 768px) {
        .scan-layout { grid-template-columns: 1fr; }
      }

      /* Card + form */
      .scan-card {
        background: var(--bg-subtle);
        border-radius: 20px;
        padding: 24px 20px;
      }

      .scan-card h2 { font-size: 1.2rem; margin-bottom: 8px; }

      .scan-card p {
        color: var(--text-muted);
        font-size: 0.92rem;
        margin-bottom: 18px;
      }

      .scan-field { margin-bottom: 16px; }

      .scan-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 6px;
        color: var(--text-muted);
      }

      .scan-input {
        width: 100%;
        max-width: 100%;
        padding: 0.75rem 0.9rem;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-size: 0.96rem;
        outline: none;
        box-sizing: border-box;
      }

      .scan-input::placeholder { color: var(--text-light); }

      .scan-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px rgba(26, 26, 46, 0.2);
      }

      .scan-help {
        font-size: 0.8rem;
        color: var(--text-light);
        margin-top: 2px;
      }

      .scan-submit { margin-top: 12px; }

      .btn-primary-full { width: 100%; justify-content: center; }

      .scan-status {
        margin-top: 10px;
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .hidden { display: none; }

      .results-card {
        background: var(--bg-subtle);
        border-radius: 20px;
        padding: 24px 20px;
      }

      .results-header {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
      }

      .results-header h2 {
        font-size: 1.35rem;
        margin-bottom: 6px;
      }

      .results-summary {
        color: var(--text-muted);
        font-size: 0.94rem;
        line-height: 1.6;
      }

      .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      @media (max-width: 640px) { .summary-grid { grid-template-columns: 1fr; } }

      .summary-chip {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 12px 14px;
      }

      .summary-chip-label {
        color: var(--text-muted);
        font-size: 0.78rem;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .summary-chip-value {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.35;
      }

      .overall-score { font-size: 1.05rem; font-weight: 600; }

      .supporting-metrics {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
      }

      .supporting-metrics-title {
        font-size: 0.78rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 10px;
      }

      .score-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }

      @media (max-width: 540px) { .score-grid { grid-template-columns: 1fr; } }

      .score-chip {
        background: var(--bg);
        border-radius: 12px;
        border: 1px solid var(--border);
        padding: 10px 12px;
        font-size: 0.85rem;
      }

      .score-label { color: var(--text-muted); margin-bottom: 2px; }

      .score-value { font-size: 1.1rem; font-weight: 600; }

      .score-basis {
        display: block;
        margin-top: 8px;
        color: var(--text-light);
        font-size: 0.78rem;
        line-height: 1.45;
      }

      .package-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        padding: 4px 8px;
        border-radius: 999px;
        background: var(--bg-subtle);
        color: var(--accent);
        margin-bottom: 8px;
      }

      .findings-list {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-top: 6px;
        padding-left: 18px;
      }

      .findings-list li + li { margin-top: 4px; }

      .strategy-block {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
        font-size: 0.9rem;
      }

      .strategy-title {
        font-weight: 600;
        margin-bottom: 6px;
        font-size: 1rem;
      }

      .strategy-text {
        color: var(--text-muted);
        line-height: 1.6;
      }

      .section-intro {
        color: var(--text-light);
        font-size: 0.84rem;
        line-height: 1.5;
        margin-bottom: 8px;
      }

      .diagnostic-note {
        margin-top: 18px;
        padding: 14px 16px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 14px;
      }

      .diagnostic-note-title {
        font-weight: 600;
        margin-bottom: 6px;
        font-size: 0.92rem;
      }

      .diagnostic-note-text {
        color: var(--text-muted);
        font-size: 0.88rem;
        line-height: 1.6;
      }

      /* Checkbox row */
      .check-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: var(--bg-subtle);
        margin-top: 8px;
      }

      .check-row input {
        width: 16px;
        height: 16px;
        margin-top: 2px;
        accent-color: var(--accent);
      }

      .check-row label {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.25rem;
        cursor: pointer;
      }

      .mini-note {
        font-size: 0.78rem;
        color: var(--text-light);
        margin-top: 8px;
      }

      /* Validation styles */
      .scan-input.error {
        border-color: var(--danger, #ff6b6b);
        box-shadow: 0 0 0 1px rgba(255, 107, 107, 0.3);
      }

      .scan-input.success {
        border-color: #4caf50;
      }

      .scan-help.error {
        color: var(--danger, #ff6b6b);
        font-size: 0.78rem;
        margin-top: 4px;
      }

      /* Loading state */
      .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .btn-spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
      }

      .btn-spinner:not(.hidden) {
        display: inline-block;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      /* CAPTCHA styling */
      .captcha-container {
        margin: 16px 0;
        display: flex;
        justify-content: center;
      }

      .captcha-error {
        color: var(--danger, #ff6b6b);
        font-size: 0.8rem;
        margin-top: 4px;
        text-align: center;
      }

      .captcha-status {
        color: var(--text-muted);
        font-size: 0.8rem;
        margin-top: 4px;
        text-align: center;
      }

      .captcha-status[data-state="ready"] {
        color: var(--success, #1f7a4d);
      }

      .captcha-status[data-state="error"] {
        color: var(--danger, #ff6b6b);
      }

      /* Q&A collapsible section */
      .qa-details { margin-top: 4px; }

      .qa-summary {
        cursor: pointer;
        list-style: none;
        padding: 12px 16px;
        background: var(--bg-subtle);
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 500;
        color: var(--accent);
        transition: all 0.2s;
      }

      .qa-summary:hover {
        background: var(--bg-elevated);
      }

      .qa-summary::-webkit-details-marker {
        display: none;
      }

      .qa-toggle {
        transition: transform 0.2s;
        font-size: 0.8rem;
      }

      .qa-details[open] .qa-toggle {
        transform: rotate(180deg);
      }

      .qa-content {
        margin-top: 12px;
        padding: 16px;
        background: var(--bg-subtle);
        border-radius: 12px;
      }

      .qa-item {
        margin-bottom: 20px;
        padding-bottom: 20px;
      }

      .qa-item:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
      }

      .qa-question {
        font-weight: 600;
        color: var(--text);
        margin-bottom: 8px;
        font-size: 0.95rem;
      }

      .qa-answer {
        color: var(--text-muted);
        line-height: 1.6;
        font-size: 0.9rem;
        white-space: pre-wrap;
      }

      .request-id-display {
        font-size: 0.75rem;
        color: var(--text-light);
        margin-top: 8px;
        font-family: monospace;
      }
    </style>
    <link rel="stylesheet" href="/styles/scan-redesign.css">
  </Fragment>

  <section class="scan-page">
    <div class="scan-header">
      <div>
        <div class="pill">Free AI Representation Check</div>
        <h1>See how AI can currently interpret your business</h1>
      </div>
      <p>
        Get a directional, explainable assessment before deciding whether deeper review is warranted.
      </p>
    </div>

    <!-- What You'll Get Section -->
    <div class="scan-guide" style="max-width: 620px; margin: 0 auto 32px; padding: 20px 24px; background: var(--bg-subtle); border-radius: 16px;">
      <h3 style="font-size: 1.05rem; margin-bottom: 12px; color: var(--text);">What This Free Scan Provides</h3>
      <ul style="margin: 0; padding-left: 20px; color: var(--text-muted); font-size: 0.9rem; line-height: 1.7;">
        <li>Three qualitative representation bands</li>
        <li>Selected supporting evidence</li>
        <li>Material gaps that may require review</li>
        <li>A practical next step tied to the findings</li>
      </ul>
      <p style="margin: 12px 0 0; font-size: 0.85rem; color: var(--text-muted); padding-top: 12px;">
        <strong>Important:</strong> This is a lightweight, automated baseline — not a comprehensive audit.
        For human-reviewed analysis across ChatGPT, Claude, and Perplexity with detailed interpretation,
        see our <a href="/packages" style="color: var(--accent); text-decoration: underline;">Tier 0 AI Understanding Snapshot ($495 CAD)</a>.
      </p>
    </div>

    <div class="scan-layout">
      <!-- Form card -->
      <div class="scan-card">
        <h2>Run Your Free Scan</h2>
        <p>
          Enter your details below. We'll email you a copy of the report and store it so you can track improvements over time.
        </p>

        <form id="scanForm">
          <div class="scan-field">
            <label for="businessName" class="scan-label">Business Name</label>
            <input
              id="businessName"
              type="text"
              required
              aria-required="true"
              aria-describedby="businessName-help"
              class="scan-input"
              placeholder="Your company name"
              minlength="2"
              maxlength="100"
            />
            <div id="businessName-help" class="scan-help hidden"></div>
          </div>

          <div class="scan-field">
            <label for="industry" class="scan-label">Industry (optional)</label>
            <input
              id="industry"
              type="text"
              aria-describedby="industry-help"
              class="scan-input"
              placeholder="e.g., SaaS, Manufacturing, Professional Services"
              maxlength="100"
            />
            <div id="industry-help" class="scan-help"></div>
          </div>

          <div class="scan-field">
            <label for="website" class="scan-label">Website URL</label>
            <input
              id="website"
              type="url"
              required
              aria-required="true"
              aria-describedby="website-help"
              class="scan-input"
              placeholder="https://yourbusiness.com"
              pattern="https?://.+"
            />
            <div id="website-help" class="scan-help hidden"></div>
          </div>

          <div class="scan-field">
            <label for="contactEmail" class="scan-label">Email (send me the report)</label>
            <input
              id="contactEmail"
              type="email"
              required
              aria-required="true"
              aria-describedby="contactEmail-help"
              class="scan-input"
              placeholder="you@company.com"
            />
            <div id="contactEmail-help" class="scan-help hidden"></div>
          </div>

          <div class="check-row">
            <input id="requestContact" type="checkbox" />
            <label for="requestContact">
              Please contact me to discuss improving these results.
              <div class="mini-note">If checked, the VizAI team will be notified.</div>
            </label>
          </div>

          <!-- Cloudflare Turnstile CAPTCHA Widget -->
          <div class="captcha-container">
            <div class="cf-turnstile"
                 id="captcha-widget"
                 data-sitekey="0x4AAAAAACKFgDePvecVK5kQ"
                 data-callback="onCaptchaSuccess"
                 data-error-callback="onCaptchaError"
                 data-expired-callback="onCaptchaExpired"
                 data-timeout-callback="onCaptchaTimeout"
                 data-response-field="false"
                 data-theme="light"></div>
          </div>
          <div id="captchaStatus" class="captcha-status" role="status" aria-live="polite">
            Security check is loading&hellip;
          </div>
          <div id="captchaError" class="captcha-error hidden" role="alert"></div>

          <p class="scan-help" style="margin-top: 10px; margin-bottom: 10px;">
            This scan typically takes 30–60 seconds. The report is AI-assisted and intended as a directional baseline.
          </p>

          <div class="scan-submit">
            <button type="submit" class="btn-primary btn-primary-full" id="scanSubmitButton" aria-busy="false">
              <span id="btnText">Run representation check</span>
              <span class="icon" id="btnIcon">&#x26A1;</span>
              <span class="btn-spinner hidden" id="btnSpinner"></span>
            </button>
          </div>

          <div id="scanStatus" class="scan-status hidden"></div>

          <div class="mini-note">
            By running a scan you agree we may store the result for comparison over time. We don't sell scan data.
          </div>
        </form>
      </div>

      <!-- Results card -->
      <div id="results" class="results-card hidden">
        <div class="results-header">
          <div>
            <div class="package-tag" id="scoreBandTag">
              <span>&#x25CE;</span>
              <span>Directional representation check</span>
            </div>
            <h2 id="resultsTitle">AI representation assessment</h2>
            <div class="results-summary" id="resultsSummary">
              This report prioritizes what the scan could verify, where support was weak, and which signals appear to be missing.
            </div>
          </div>
        </div>

        <div class="supporting-metrics">
          <div class="supporting-metrics-title">Assessment bands</div>
          <div class="score-grid">
            <div class="score-chip">
              <div class="score-label">Findability</div>
              <div class="score-value" id="findabilityBand">Assessing</div>
              <small class="score-basis" id="findabilityBasis">Reviewing whether the business can be consistently identified.</small>
            </div>
            <div class="score-chip">
              <div class="score-label">Fidelity</div>
              <div class="score-value" id="fidelityBand">Assessing</div>
              <small class="score-basis" id="fidelityBasis">Comparing observed descriptions with the submitted business details.</small>
            </div>
            <div class="score-chip">
              <div class="score-label">Source readiness</div>
              <div class="score-value" id="sourceReadinessBand">Assessing</div>
              <small class="score-basis" id="sourceReadinessBasis">Reviewing the strength and structure of available sources.</small>
            </div>
          </div>
        </div>

        <div class="strategy-block">
          <div class="strategy-title">Selected supporting evidence</div>
          <div class="section-intro">Signals the check could identify with comparatively stronger support.</div>
          <ul class="findings-list" id="verifiedList"></ul>
        </div>

        <div class="strategy-block">
          <div class="strategy-title">Findings requiring review</div>
          <div class="section-intro">Claims that appeared incomplete, inconsistent, or not strongly supported by the evidence available to the scan.</div>
          <ul class="findings-list" id="unclearList"></ul>
        </div>

        <div class="strategy-block">
          <div class="strategy-title">Missing or not detected</div>
          <div class="section-intro">Signals the scan expected to find but could not verify clearly from available sources.</div>
          <ul class="findings-list" id="missingList"></ul>
        </div>

        <div id="packageBlock" class="strategy-block">
          <div class="strategy-title" id="packageTitle">Recommended next fix</div>
          <div class="strategy-text" id="packageText"></div>
          <div class="request-id-display" id="requestIdDisplay" style="display: none;"></div>
        </div>

        <div id="diagnosticNote" class="diagnostic-note hidden">
          <div class="diagnostic-note-title" id="diagnosticNoteTitle">Scan limitations</div>
          <div class="diagnostic-note-text" id="diagnosticNoteText"></div>
        </div>

        <div class="diagnostic-note">
          <div class="diagnostic-note-title">Methodology boundary</div>
          <div class="diagnostic-note-text">This automated check is directional, time-specific, and dependent on selected systems and available public information. The assessment bands explain the observed signal; they do not guarantee crawling, citation, ranking, recommendation, or future answer changes.</div>
        </div>

        <div class="strategy-block" id="qaBlock" style="display: none;">
          <details class="qa-details">
            <summary class="qa-summary">
              <span>View raw AI responses</span>
              <span class="qa-toggle">&#x25BC;</span>
            </summary>
            <div class="qa-content" id="qaContent"></div>
          </details>
        </div>
      </div>

      <!-- Next Steps Card (shown after results) -->
      <div id="nextStepsCard" class="scan-card hidden" style="margin-top: 24px;">
        <h2>What to Do Next</h2>
        <div id="nextStepsContent"></div>
        <div style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/contact" class="btn-primary" style="text-decoration: none;">
            <span>Discuss This Result</span>
            <span class="icon">&rarr;</span>
          </a>
          <a href="/packages" class="btn-secondary" style="text-decoration: none;">
            <span>View All Packages</span>
            <span class="icon">&rarr;</span>
          </a>
          <a href="/sample-report" class="btn-secondary" style="text-decoration: none;">
            <span>See the Reviewed Report</span>
            <span class="icon">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { calibrateScanReport } from "../lib/scan-calibration.js";
    import { describeTurnstileError } from "../lib/turnstile-state.js";

    const API_BASE = "https://lmo-backend.onrender.com";

    const form = document.getElementById("scanForm");
    const statusEl = document.getElementById("scanStatus");
    const resultsCard = document.getElementById("results");
    const submitBtn = document.getElementById("scanSubmitButton");
    const btnText = document.getElementById("btnText");
    const btnIcon = document.getElementById("btnIcon");
    const btnSpinner = document.getElementById("btnSpinner");

    const businessNameInput = document.getElementById("businessName");
    const websiteInput = document.getElementById("website");
    const contactEmailInput = document.getElementById("contactEmail");
    const captchaStatusEl = document.getElementById("captchaStatus");
    const captchaErrorEl = document.getElementById("captchaError");

    const resultsTitleEl = document.getElementById("resultsTitle");
    const resultsSummaryEl = document.getElementById("resultsSummary");
    const findabilityBandEl = document.getElementById("findabilityBand");
    const fidelityBandEl = document.getElementById("fidelityBand");
    const sourceReadinessBandEl = document.getElementById("sourceReadinessBand");
    const findabilityBasisEl = document.getElementById("findabilityBasis");
    const fidelityBasisEl = document.getElementById("fidelityBasis");
    const sourceReadinessBasisEl = document.getElementById("sourceReadinessBasis");
    const verifiedListEl = document.getElementById("verifiedList");
    const unclearListEl = document.getElementById("unclearList");
    const missingListEl = document.getElementById("missingList");
    const scoreBandTagEl = document.getElementById("scoreBandTag");
    const packageTitleEl = document.getElementById("packageTitle");
    const packageTextEl = document.getElementById("packageText");
    const requestIdDisplayEl = document.getElementById("requestIdDisplay");
    const diagnosticNoteEl = document.getElementById("diagnosticNote");
    const diagnosticNoteTitleEl = document.getElementById("diagnosticNoteTitle");
    const diagnosticNoteTextEl = document.getElementById("diagnosticNoteText");
    const qaBlockEl = document.getElementById("qaBlock");
    const qaContentEl = document.getElementById("qaContent");
    const nextStepsCardEl = document.getElementById("nextStepsCard");
    const nextStepsContentEl = document.getElementById("nextStepsContent");

    // CAPTCHA token
    var captchaToken = null;
    var captchaFailureCode = "";
    var captchaBlocked = false;
    var isSubmitting = false;

    function syncSubmitAvailability() {
      submitBtn.disabled = isSubmitting || captchaBlocked;
    }

    function setCaptchaStatus(message, state) {
      captchaStatusEl.textContent = message;
      captchaStatusEl.dataset.state = state;
    }

    function resetCaptcha() {
      captchaToken = null;
      captchaFailureCode = "";
      captchaBlocked = false;
      setCaptchaStatus("Security check is refreshing\u2026", "pending");
      captchaErrorEl.classList.add("hidden");
      syncSubmitAvailability();

      if (window.turnstile) {
        window.turnstile.reset("#captcha-widget");
      }
    }

    // CAPTCHA callbacks (must be global for Turnstile)
    window.onCaptchaSuccess = function(token) {
      captchaToken = token;
      captchaFailureCode = "";
      captchaBlocked = false;
      setCaptchaStatus("Security check ready.", "ready");
      captchaErrorEl.classList.add("hidden");
      syncSubmitAvailability();
    };

    window.onCaptchaError = function(errorCode) {
      captchaToken = null;
      captchaFailureCode = String(errorCode || "");
      var failure = describeTurnstileError(captchaFailureCode, window.location.hostname);
      captchaBlocked = failure.blocking;
      setCaptchaStatus("Security check unavailable.", "error");
      captchaErrorEl.textContent = failure.message;
      captchaErrorEl.classList.remove("hidden");
      syncSubmitAvailability();
    };

    window.onCaptchaExpired = function() {
      resetCaptcha();
    };

    window.onCaptchaTimeout = function() {
      resetCaptcha();
    };

    // Rate limiting
    var lastSubmitTime = 0;
    var MIN_SUBMIT_INTERVAL = 5000; // 5 seconds between submissions

    // Input sanitization
    function sanitizeInput(input) {
      return input.trim().replace(/[<>]/g, '');
    }

    // Validation functions
    function validateBusinessName(name) {
      var sanitized = sanitizeInput(name);
      if (!sanitized || sanitized.length < 2) {
        return { valid: false, message: "Business name must be at least 2 characters" };
      }
      if (sanitized.length > 100) {
        return { valid: false, message: "Business name must be less than 100 characters" };
      }
      return { valid: true, value: sanitized };
    }

    function validateWebsite(url) {
      var sanitized = sanitizeInput(url);
      try {
        var urlObj = new URL(sanitized);
        if (!['http:', 'https:'].includes(urlObj.protocol)) {
          return { valid: false, message: "URL must start with http:// or https://" };
        }
        return { valid: true, value: sanitized };
      } catch (e) {
        return { valid: false, message: "Please enter a valid URL (e.g., https://example.com)" };
      }
    }

    function validateEmail(email) {
      var sanitized = sanitizeInput(email);
      var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(sanitized)) {
        return { valid: false, message: "Please enter a valid email address" };
      }
      return { valid: true, value: sanitized };
    }

    function renderList(element, items, emptyText) {
      element.innerHTML = "";
      var listItems = items.length ? items : [emptyText];
      listItems.forEach(function(item) {
        var li = document.createElement("li");
        li.textContent = item;
        element.appendChild(li);
      });
    }

    function assessmentBand(score, strong, developing, limited) {
      if (score >= 75) return strong;
      if (score >= 45) return developing;
      return limited;
    }

    // Show validation error
    function showError(input, message) {
      input.classList.add("error");
      input.classList.remove("success");
      var helpId = input.getAttribute("aria-describedby");
      var helpEl = document.getElementById(helpId);
      if (helpEl) {
        helpEl.textContent = message;
        helpEl.classList.remove("hidden");
        helpEl.classList.add("error");
      }
    }

    // Clear validation error
    function clearError(input) {
      input.classList.remove("error");
      input.classList.add("success");
      var helpId = input.getAttribute("aria-describedby");
      var helpEl = document.getElementById(helpId);
      if (helpEl) {
        helpEl.textContent = "";
        helpEl.classList.add("hidden");
        helpEl.classList.remove("error");
      }
    }

    // Real-time validation
    businessNameInput.addEventListener("blur", function() {
      var result = validateBusinessName(businessNameInput.value);
      if (!result.valid) {
        showError(businessNameInput, result.message);
      } else {
        clearError(businessNameInput);
      }
    });

    websiteInput.addEventListener("blur", function() {
      var result = validateWebsite(websiteInput.value);
      if (!result.valid) {
        showError(websiteInput, result.message);
      } else {
        clearError(websiteInput);
      }
    });

    contactEmailInput.addEventListener("blur", function() {
      var result = validateEmail(contactEmailInput.value);
      if (!result.valid) {
        showError(contactEmailInput, result.message);
      } else {
        clearError(contactEmailInput);
      }
    });

    // Set loading state
    function setLoading(loading) {
      isSubmitting = loading;
      syncSubmitAvailability();
      submitBtn.setAttribute("aria-busy", loading ? "true" : "false");

      if (loading) {
        btnText.textContent = "Checking representation...";
        btnIcon.classList.add("hidden");
        btnSpinner.classList.remove("hidden");
      } else {
        btnText.textContent = "Run representation check";
        btnIcon.classList.remove("hidden");
        btnSpinner.classList.add("hidden");
      }
    }

    // Show user-friendly error
    function showUserError(error, statusElement) {
      var message = "An error occurred. Please try again.";

      if (!navigator.onLine) {
        message = "No internet connection. Please check your network and try again.";
      } else if (error.message.includes("CAPTCHA") || error.message.includes("Captcha")) {
        // Use backend error message if available, otherwise use default
        message = error.message.startsWith("API error")
          ? "CAPTCHA verification failed. Please refresh the page and try again."
          : error.message;
        // Reset captcha widget
        if (window.turnstile) {
          window.turnstile.reset();
        }
      } else if (error.message.includes("429")) {
        message = "Too many requests. Please wait a moment and try again.";
      } else if (error.message.startsWith("API error")) {
        // Generic API error fallback
        if (error.message.includes("500") || error.message.includes("503")) {
          message = "Our servers are temporarily unavailable. Please try again in a few minutes.";
        } else {
          message = "Invalid request. Please check your information and try again.";
        }
      } else if (error.message.includes("timeout") || error.name === "AbortError") {
        message = "Request timed out. Please try again.";
      } else if (error.message.length > 10 && !error.message.startsWith("API error")) {
        // Use the backend's detailed error message directly
        message = error.message;
      }

      statusElement.textContent = message;
      statusElement.classList.remove("hidden");
    }

    form.addEventListener("submit", async function(e) {
      e.preventDefault();

      // Check rate limiting
      var now = Date.now();
      if (now - lastSubmitTime < MIN_SUBMIT_INTERVAL) {
        var waitTime = Math.ceil((MIN_SUBMIT_INTERVAL - (now - lastSubmitTime)) / 1000);
        statusEl.textContent = "Please wait " + waitTime + " seconds before submitting again.";
        statusEl.classList.remove("hidden");
        return;
      }

      // Validate all fields
      var nameValidation = validateBusinessName(businessNameInput.value);
      var websiteValidation = validateWebsite(websiteInput.value);
      var emailValidation = validateEmail(contactEmailInput.value);

      var hasErrors = false;

      if (!nameValidation.valid) {
        showError(businessNameInput, nameValidation.message);
        hasErrors = true;
      }
      if (!websiteValidation.valid) {
        showError(websiteInput, websiteValidation.message);
        hasErrors = true;
      }
      if (!emailValidation.valid) {
        showError(contactEmailInput, emailValidation.message);
        hasErrors = true;
      }

      if (hasErrors) return;

      // Validate CAPTCHA
      if (!captchaToken) {
        if (!captchaFailureCode) {
          setCaptchaStatus("Security check is still running\u2026", "pending");
          captchaErrorEl.textContent = "Wait a moment for the automatic security check, then try again.";
        }
        captchaErrorEl.classList.remove("hidden");
        return;
      }

      var businessName = nameValidation.value;
      var website = websiteValidation.value;
      var contactEmail = emailValidation.value;
      var requestContact = !!document.getElementById("requestContact").checked;
      var industry = sanitizeInput(document.getElementById("industry").value) || null;

      lastSubmitTime = now;
      statusEl.textContent = "Running representation check\u2026 (30\u201360s)";
      statusEl.classList.remove("hidden");
      resultsCard.classList.add("hidden");
      setLoading(true);

      // Set timeout for long-running requests
      var controller = new AbortController();
      var timeoutId = setTimeout(function() { controller.abort(); }, 90000); // 90 second timeout

      try {
        var resp = await fetch(API_BASE + "/run_scan", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            businessName: businessName,
            industry: industry,
            website: website,
            contactEmail: contactEmail,
            requestContact: requestContact,
            captchaToken: captchaToken,
            models: []
          }),
          signal: controller.signal
        });

        clearTimeout(timeoutId);

        if (!resp.ok) {
          var errorMessage = "API error " + resp.status;
          try {
            var errorData = await resp.json();
            if (errorData && typeof errorData === "object") {
              if (typeof errorData.detail === "string" && errorData.detail.trim()) {
                errorMessage = errorData.detail;
              } else if (typeof errorData.error === "string" && errorData.error.trim()) {
                errorMessage = errorData.error;
              }
            }
          } catch (jsonErr) {
            var txt = "";
            try { txt = await resp.text(); } catch (txtErr) {}
            if (txt) {
              errorMessage = errorMessage + " " + txt;
            }
          }
          throw new Error(errorMessage);
        }

        var data = await resp.json();

        var d = Number(data.discovery_score || 0);
        var a = Number(data.accuracy_score || 0);
        var au = Number(data.authority_score || 0);

        var overall = Number.isFinite(Number(data.overall_score))
          ? Number(data.overall_score)
          : Math.round((d + a + au) / 3);

        var calibration = calibrateScanReport(data, { overallScore: overall });

        findabilityBandEl.textContent = assessmentBand(d, "Established", "Developing", "Limited");
        fidelityBandEl.textContent = assessmentBand(a, "Mostly aligned", "Needs review", "Material gaps");
        sourceReadinessBandEl.textContent = assessmentBand(au, "Well supported", "Developing", "Needs structure");
        findabilityBasisEl.textContent = "Basis: selected-system discovery and identity observations.";
        fidelityBasisEl.textContent = "Basis: submitted facts compared with observed descriptions.";
        sourceReadinessBasisEl.textContent = "Basis: available public sources, proof points, and structure.";
        resultsTitleEl.textContent = calibration.headline;
        resultsSummaryEl.textContent = calibration.summary;

        scoreBandTagEl.innerHTML = "<span>\u25CE</span><span>" + calibration.bandLabel + "</span>";
        packageTitleEl.textContent = calibration.recommendationTitle;
        packageTextEl.textContent = calibration.recommendationText;

        // Populate next steps card
        nextStepsContentEl.innerHTML = calibration.nextStepsHTML;
        nextStepsCardEl.classList.remove("hidden");

        renderList(
          verifiedListEl,
          calibration.verified,
          "The scan did not return any clearly verified signals in this response."
        );
        renderList(
          unclearListEl,
          calibration.unclear,
          "The scan did not flag any additional weakly supported claims in this response."
        );
        renderList(
          missingListEl,
          calibration.missing,
          "The scan did not report specific missing signals in this response."
        );

        if (calibration.noteText) {
          diagnosticNoteTitleEl.textContent = calibration.noteTitle;
          diagnosticNoteTextEl.textContent = calibration.noteText;
          diagnosticNoteEl.classList.remove("hidden");
        } else {
          diagnosticNoteTextEl.textContent = "";
          diagnosticNoteEl.classList.add("hidden");
        }

        // Display request ID
        var requestId = resp.headers.get("X-Request-ID");
        if (requestId) {
          requestIdDisplayEl.textContent = "Request ID: " + requestId;
          requestIdDisplayEl.style.display = "block";
        } else {
          requestIdDisplayEl.style.display = "none";
        }

        // Display Q&A pairs
        var qaPairs = Array.isArray(data.qa_pairs) ? data.qa_pairs : [];
        if (qaPairs.length > 0) {
          qaContentEl.innerHTML = "";
          qaPairs.forEach(function(qa) {
            var qaItem = document.createElement("div");
            qaItem.className = "qa-item";

            var question = document.createElement("div");
            question.className = "qa-question";
            question.textContent = qa.question;

            var answer = document.createElement("div");
            answer.className = "qa-answer";
            answer.textContent = qa.answer;

            qaItem.appendChild(question);
            qaItem.appendChild(answer);
            qaContentEl.appendChild(qaItem);
          });
          qaBlockEl.style.display = "block";
        } else {
          qaContentEl.innerHTML = "";
          qaBlockEl.style.display = "none";
        }

        resultsCard.classList.remove("hidden");
        statusEl.classList.add("hidden");
        resultsCard.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (err) {
        // Track error
        if (window.trackError) {
          window.trackError(err, {
            context: 'scan_form_submission',
            businessName: businessName,
            website: website
          });
        }

        showUserError(err, statusEl);
      } finally {
        clearTimeout(timeoutId);
        setLoading(false);
        resetCaptcha();
      }
    });
  </script>
</RedesignLayout>
